    in-out property <string> artist-color: "#a3a3a3";
    in-out property <[CustomTextBlockData]> custom-text-blocks: [];
    callback add-custom-text-clicked();
    callback remove-custom-text-clicked(int);
    callback custom-text-edited(int, string, bool, float, float, float, string, string, string);

    callback config-changed();
    callback theme-preset-selected(string);
    callback open-radial-image-clicked();
    callback remove-radial-image-clicked();

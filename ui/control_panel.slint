                        SliderRow {
                            label: "Animation Speed";
                            value-text: Math.round(root.nebula-speed * 100) + "%";
                            minimum: 0.2;
                            maximum: 3.0;
                            default-value: 1.0;
                            value: root.nebula-speed;
                            changed(val) => { root.nebula-speed = val; root.config-changed(); }
                        }

                    if (root.bg-mode == "Aurora") : VerticalLayout {
                        spacing: 10px;
                        SectionTitle { text: "AURORA SETTINGS"; }
                        SliderRow {
                            label: "Wave Speed";
                            value-text: Math.round(root.aurora-speed * 100) + "%";
                            minimum: 0.2;
                            maximum: 3.0;
                            default-value: 1.0;
                            value: root.aurora-speed;
                            changed(val) => { root.aurora-speed = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Wave Height";
                            value-text: Math.round(root.aurora-amplitude) + "px";
                            minimum: 10.0;
                            maximum: 120.0;
                            default-value: 50.0;
                            value: root.aurora-amplitude;
                            changed(val) => { root.aurora-amplitude = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Aurora Opacity";
                            value-text: Math.round(root.aurora-opacity * 100) + "%";
                            minimum: 0.05;
                            maximum: 0.6;
                            default-value: 0.3;
                            value: root.aurora-opacity;
                            changed(val) => { root.aurora-opacity = val; root.config-changed(); }
                        }
                    }

                    if (root.bg-mode == "Noise") : VerticalLayout {
                        spacing: 10px;
                        SectionTitle { text: "FILM GRAIN SETTINGS"; }
                        SliderRow {
                            label: "Grain Opacity";
                            value-text: Math.round(root.grain-opacity * 100) + "%";
                            minimum: 0.01;
                            maximum: 0.3;
                            default-value: 0.08;
                            value: root.grain-opacity;
                            changed(val) => { root.grain-opacity = val; root.config-changed(); }
                        }
                    }

                    if (root.bg-mode == "Bokeh") : VerticalLayout {
                        spacing: 10px;
                        SectionTitle { text: "BOKEH SETTINGS"; }
                        SliderRow {
                            label: "Orb Count";
                            value-text: Math.round(root.bokeh-count) + "";
                            minimum: 5.0;
                            maximum: 40.0;
                            default-value: 15.0;
                            value: root.bokeh-count;
                            changed(val) => { root.bokeh-count = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Orb Size";
                            value-text: Math.round(root.bokeh-size) + "px";
                            minimum: 10.0;
                            maximum: 80.0;
                            default-value: 40.0;
                            value: root.bokeh-size;
                            changed(val) => { root.bokeh-size = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Bokeh Opacity";
                            value-text: Math.round(root.bokeh-opacity * 100) + "%";
                            minimum: 0.05;
                            maximum: 0.6;
                            default-value: 0.25;
                            value: root.bokeh-opacity;
                            changed(val) => { root.bokeh-opacity = val; root.config-changed(); }
                        }
                    }

                    if (root.bg-mode == "Psychedelic") : VerticalLayout {
                        spacing: 10px;
                        SectionTitle { text: "PSYCHEDELIC SETTINGS"; }
                        SliderRow {
                            label: "Spiral Speed";
                            value-text: Math.round(root.psychedelic-speed * 100) + "%";
                            minimum: 0.2;
                            maximum: 3.0;
                            default-value: 1.0;
                            value: root.psychedelic-speed;
                            changed(val) => { root.psychedelic-speed = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Ring Count";
                            value-text: Math.round(root.psychedelic-bands) + "";
                            minimum: 10.0;
                            maximum: 50.0;
                            default-value: 20.0;
                            value: root.psychedelic-bands;
                            changed(val) => { root.psychedelic-bands = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Line Width";
                            value-text: Math.round(root.psychedelic-line-width) + "px";
                            minimum: 1.0;
                            maximum: 12.0;
                            default-value: 3.0;
                            value: root.psychedelic-line-width;
                            changed(val) => { root.psychedelic-line-width = val; root.config-changed(); }
                        }
                    }

                    SectionTitle { text: "FLOATING DECORATIONS"; }
                    CheckBox {
                        text: "Show Floating Particles";
                        checked: root.show-particles;
                        toggled => { root.show-particles = self.checked; root.config-changed(); }
                    }
                    if (root.show-particles) : VerticalLayout {
                        spacing: 10px;
                        Text { text: "Movement Style"; color: #a3a3a3; font-size: 11px; }
                        ComboBox {
                            height: 34px;
                            model: ["Float", "Bounce", "Wave", "Static", "Confined"];
                            current-value: root.particle-style;
                            current-index: root.particle-style == "Float" ? 0 : root.particle-style == "Bounce" ? 1 : root.particle-style == "Wave" ? 2 : root.particle-style == "Static" ? 3 : 4;
                            selected(val) => { root.particle-style = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Particle Count";
                            value-text: Math.round(root.particle-count) + "";
                            minimum: 10.0;
                            maximum: 150.0;
                            default-value: 50.0;
                            value: root.particle-count;
                            changed(val) => { root.particle-count = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Particle Size";
                            value-text: Math.round(root.particle-size) + "px";
                            minimum: 1.0;
                            maximum: 12.0;
                            default-value: 3.0;
                            value: root.particle-size;
                            changed(val) => { root.particle-size = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Reactivity Speed";
                            value-text: Math.round(root.particle-speed * 100) + "%";
                            minimum: 0.2;
                            maximum: 3.0;
                            default-value: 1.0;
                            value: root.particle-speed;
                            changed(val) => { root.particle-speed = val; root.config-changed(); }
                        }
                        ColorPickerField {
                            label: "Particle Color";
                            hex-val: root.particle-color;
                            changed(val) => { root.particle-color = val; root.config-changed(); }
                        }
                    }

                    CheckBox {
                        text: "Show Music Notes";
                        checked: root.show-music-notes;
                        toggled => { root.show-music-notes = self.checked; root.config-changed(); }
                    }
                    if (root.show-music-notes) : VerticalLayout {
                        spacing: 10px;
                        Text { text: "Movement Style"; color: #a3a3a3; font-size: 11px; }
                        ComboBox {
                            height: 34px;
                            model: ["Float", "Bounce", "Spiral", "Wave", "Burst", "Confined"];
                            current-value: root.music-note-style;
                            current-index: root.music-note-style == "Float" ? 0 : root.music-note-style == "Bounce" ? 1 : root.music-note-style == "Spiral" ? 2 : root.music-note-style == "Wave" ? 3 : root.music-note-style == "Burst" ? 4 : 5;
                            selected(val) => { root.music-note-style = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Max Note Count";
                            value-text: Math.round(root.music-note-count) + "";
                            minimum: 10.0;
                            maximum: 80.0;
                            default-value: 30.0;
                            value: root.music-note-count;
                            changed(val) => { root.music-note-count = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Note Size";
                            value-text: Math.round(root.music-note-size) + "px";
                            minimum: 16.0;
                            maximum: 120.0;
                            default-value: 40.0;
                            value: root.music-note-size;
                            changed(val) => { root.music-note-size = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Beat Sensitivity";
                            value-text: Math.round(root.music-note-sensitivity * 100) + "%";
                            minimum: 0.0;
                            maximum: 2.0;
                            default-value: 1.0;
                            value: root.music-note-sensitivity;
                            changed(val) => { root.music-note-sensitivity = val; root.config-changed(); }
                        }
                        ColorPickerField {
                            label: "Note Color";
                            hex-val: root.music-note-color;
                            changed(val) => { root.music-note-color = val; root.config-changed(); }
                        }
                    }

                    CheckBox {
                        text: "Show Fireworks & Starburst Constellations";
                        checked: root.show-fireworks;
                        toggled => { root.show-fireworks = self.checked; root.config-changed(); }
                    }
                    if (root.show-fireworks) : VerticalLayout {
                        spacing: 10px;
                        SliderRow {
                            label: "Burst Count";
                            value-text: Math.round(root.fireworks-count) + "";
                            minimum: 3.0;
                            maximum: 20.0;
                            default-value: 8.0;
                            value: root.fireworks-count;
                            changed(val) => { root.fireworks-count = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Spark Size";
                            value-text: Math.round(root.fireworks-size) + "px";
                            minimum: 1.0;
                            maximum: 12.0;
                            default-value: 4.0;
                            value: root.fireworks-size;
                            changed(val) => { root.fireworks-size = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Expansion Speed";
                            value-text: Math.round(root.fireworks-speed * 100) + "%";
                            minimum: 0.2;
                            maximum: 3.0;
                            default-value: 1.0;
                            value: root.fireworks-speed;
                            changed(val) => { root.fireworks-speed = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "3D Perspective Depth";
                            value-text: Math.round(root.fireworks-depth * 100) + "%";
                            minimum: 0.5;
                            maximum: 3.0;
                            default-value: 1.0;
                            value: root.fireworks-depth;
                            changed(val) => { root.fireworks-depth = val; root.config-changed(); }
                        }
                        ColorPickerField {
                            label: "Fireworks Color";
                            hex-val: root.fireworks-color;
                            changed(val) => { root.fireworks-color = val; root.config-changed(); }
                        }
                    }

                    CheckBox {
                        text: "Show Matrix Code Rain";
                        checked: root.show-matrix-rain;
                        toggled => { root.show-matrix-rain = self.checked; root.config-changed(); }
                    }
                    if (root.show-matrix-rain) : VerticalLayout {
                        spacing: 10px;
                        SliderRow {
                            label: "Column Count";
                            value-text: Math.round(root.matrix-rain-count) + "";
                            minimum: 10.0;
                            maximum: 90.0;
                            default-value: 40.0;
                            value: root.matrix-rain-count;
                            changed(val) => { root.matrix-rain-count = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Glyph Size";
                            value-text: Math.round(root.matrix-rain-size) + "px";
                            minimum: 2.0;
                            maximum: 12.0;
                            default-value: 6.0;
                            value: root.matrix-rain-size;
                            changed(val) => { root.matrix-rain-size = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Fall Speed";
                            value-text: Math.round(root.matrix-rain-speed * 100) + "%";
                            minimum: 0.2;
                            maximum: 3.0;
                            default-value: 1.0;
                            value: root.matrix-rain-speed;
                            changed(val) => { root.matrix-rain-speed = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "3D Grid Depth";
                            value-text: Math.round(root.matrix-rain-depth * 100) + "%";
                            minimum: 0.5;
                            maximum: 3.0;
                            default-value: 1.0;
                            value: root.matrix-rain-depth;
                            changed(val) => { root.matrix-rain-depth = val; root.config-changed(); }
                        }
                        ColorPickerField {
                            label: "Matrix Color";
                            hex-val: root.matrix-rain-color;
                            changed(val) => { root.matrix-rain-color = val; root.config-changed(); }
                        }
                    }

                    CheckBox {
                        text: "Show Fireflies & Magic Dust";
                        checked: root.show-fireflies;
                        toggled => { root.show-fireflies = self.checked; root.config-changed(); }
                    }
                    if (root.show-fireflies) : VerticalLayout {
                        spacing: 10px;
                        SliderRow {
                            label: "Firefly Count";
                            value-text: Math.round(root.fireflies-count) + "";
                            minimum: 10.0;
                            maximum: 100.0;
                            value: root.fireflies-count;
                            changed(val) => { root.fireflies-count = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Glow Size";
                            value-text: Math.round(root.fireflies-size) + "px";
                            minimum: 2.0;
                            maximum: 16.0;
                            value: root.fireflies-size;
                            changed(val) => { root.fireflies-size = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Drift Speed";
                            value-text: Math.round(root.fireflies-speed * 100) + "%";
                            minimum: 0.2;
                            maximum: 3.0;
                            value: root.fireflies-speed;
                            changed(val) => { root.fireflies-speed = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "3D Swarm Depth";
                            value-text: Math.round(root.fireflies-depth * 100) + "%";
                            minimum: 0.5;
                            maximum: 3.0;
                            value: root.fireflies-depth;
                            changed(val) => { root.fireflies-depth = val; root.config-changed(); }
                        }
                        ColorPickerField {
                            label: "Firefly Color";
                            hex-val: root.fireflies-color;
                            changed(val) => { root.fireflies-color = val; root.config-changed(); }
                        }
                    }

                    CheckBox {
                        text: "Show Floating Sakura Petals";
                        checked: root.show-sakura;
                        toggled => { root.show-sakura = self.checked; root.config-changed(); }
                    }
                    if (root.show-sakura) : VerticalLayout {
                        spacing: 10px;
                        SliderRow {
                            label: "Petal Count";
                            value-text: Math.round(root.sakura-count) + "";
                            minimum: 10.0;
                            maximum: 80.0;
                            value: root.sakura-count;
                            changed(val) => { root.sakura-count = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Petal Size";
                            value-text: Math.round(root.sakura-size) + "px";
                            minimum: 4.0;
                            maximum: 24.0;
                            value: root.sakura-size;
                            changed(val) => { root.sakura-size = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Fall Speed";
                            value-text: Math.round(root.sakura-speed * 100) + "%";
                            minimum: 0.2;
                            maximum: 3.0;
                            value: root.sakura-speed;
                            changed(val) => { root.sakura-speed = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "3D Tumbling Spin Rate";
                            value-text: Math.round(root.sakura-depth * 100) + "%";
                            minimum: 0.5;
                            maximum: 3.0;
                            value: root.sakura-depth;
                            changed(val) => { root.sakura-depth = val; root.config-changed(); }
                        }
                        ColorPickerField {
                            label: "Sakura Color";
                            hex-val: root.sakura-color;
                            changed(val) => { root.sakura-color = val; root.config-changed(); }
                        }
                    }

                    CheckBox {
                        text: "Show Cyber Lightning Arcs";
                        checked: root.show-cyber-lightning;
                        toggled => { root.show-cyber-lightning = self.checked; root.config-changed(); }
                    }
                    if (root.show-cyber-lightning) : VerticalLayout {
                        spacing: 10px;
                        SliderRow {
                            label: "Arc Count";
                            value-text: Math.round(root.cyber-lightning-count) + "";
                            minimum: 2.0;
                            maximum: 12.0;
                            value: root.cyber-lightning-count;
                            changed(val) => { root.cyber-lightning-count = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Arc Thickness";
                            value-text: Math.round(root.cyber-lightning-size) + "px";
                            minimum: 1.0;
                            maximum: 8.0;
                            value: root.cyber-lightning-size;
                            changed(val) => { root.cyber-lightning-size = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Flash Speed";
                            value-text: Math.round(root.cyber-lightning-speed * 100) + "%";
                            minimum: 0.2;
                            maximum: 3.0;
                            value: root.cyber-lightning-speed;
                            changed(val) => { root.cyber-lightning-speed = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "3D Mesh Radius";
                            value-text: Math.round(root.cyber-lightning-depth * 100) + "%";
                            minimum: 0.5;
                            maximum: 3.0;
                            value: root.cyber-lightning-depth;
                            changed(val) => { root.cyber-lightning-depth = val; root.config-changed(); }
                        }
                        ColorPickerField {
                            label: "Lightning Color";
                            hex-val: root.cyber-lightning-color;
                            changed(val) => { root.cyber-lightning-color = val; root.config-changed(); }
                        }
                    }
                }

                // EFFECTS TAB
                if (root.active-tab == "effects") : VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    SectionTitle { text: "SCREEN EFFECTS"; }

                    CheckBox {
                        text: "Enable Effects";
                        checked: root.effects-enabled;
                        toggled => { root.effects-enabled = self.checked; root.config-changed(); }
                    }

                    if (root.effects-enabled) : VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        CheckBox {
                            text: "Apply Effects to Background Only";
                            checked: root.bg-only-effect;
                            toggled => { root.bg-only-effect = self.checked; root.config-changed(); }
                        }

                        Text { text: "Effect Type"; color: #a3a3a3; font-size: 11px; }
                        ComboBox {
                            height: 34px;
                            model: ["None", "Shake", "Glitch", "Vignette", "Pulse", "Spotlight", "Strobe", "Scanline", "Chromatic Aberration", "Zoom", "Invert", "Bars", "Shockwave", "Pixelate", "Tilt", "Heat Haze", "Hue Shift", "Glass Crack"];
                            current-value: root.main-effect;
                            current-index: root.main-effect == "None" ? 0 : root.main-effect == "Shake" ? 1 : root.main-effect == "Glitch" ? 2 : root.main-effect == "Vignette" ? 3 : root.main-effect == "Pulse" ? 4 : root.main-effect == "Spotlight" ? 5 : root.main-effect == "Strobe" ? 6 : root.main-effect == "Scanline" ? 7 : root.main-effect == "Chromatic Aberration" ? 8 : root.main-effect == "Zoom" ? 9 : root.main-effect == "Invert" ? 10 : root.main-effect == "Bars" ? 11 : root.main-effect == "Shockwave" ? 12 : root.main-effect == "Pixelate" ? 13 : root.main-effect == "Tilt" ? 14 : root.main-effect == "Heat Haze" ? 15 : root.main-effect == "Hue Shift" ? 16 : 17;
                            selected(val) => { root.main-effect = val; root.config-changed(); }
                        }

                        Text {
                            text: root.main-effect == "Shake" ? "Canvas vibrates with the beat (background parallax depth)"
                                : root.main-effect == "Glitch" ? "Random slice displacement & color artifacts"
                                : root.main-effect == "Vignette" ? "Edges darken dynamically on bass hits"
                                : root.main-effect == "Pulse" ? "Bright flash on each beat"
                                : root.main-effect == "Spotlight" ? "Concert light beams from above"
                                : root.main-effect == "Strobe" ? "Rapid white flashes synced to the music"
                                : root.main-effect == "Scanline" ? "Retro TV scanlines that darken with the beat"
                                : root.main-effect == "Chromatic Aberration" ? "RGB color-split ghosting on bass"
                                : root.main-effect == "Zoom" ? "Canvas zooms in on each beat"
                                : root.main-effect == "Invert" ? "Colors briefly invert on bass hits"
                                : root.main-effect == "Bars" ? "Letterbox bars push in on bass"
                                : root.main-effect == "Shockwave" ? "Radial ripple distortion from the center on each beat"
                                : root.main-effect == "Pixelate" ? "Frame drops to chunky blocks on bass"
                                : root.main-effect == "Tilt" ? "Canvas tilts back & forth with the music"
                                : root.main-effect == "Heat Haze" ? "Wavy air distortion shimmering on bass"
                                : root.main-effect == "Hue Shift" ? "Colors drift continuously through the spectrum"
                                : root.main-effect == "Glass Crack" ? "Cracked glass shards refraction & geometric break lines"
                                : "No active screen effect";
                            color: #737373;
                            font-size: 11px;
                        }

                        if (root.main-effect == "Shake") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Shake Intensity";
                                value-text: Math.round(root.shake-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 3.0;
                                value: root.shake-intensity;
                                changed(val) => { root.shake-intensity = val; root.config-changed(); }
                            }
                            SliderRow {
                                label: "Shake Frequency";
                                value-text: Math.round(root.shake-frequency * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.shake-frequency;
                                changed(val) => { root.shake-frequency = val; root.config-changed(); }
                            }
                            SliderRow {
                                label: "Max Offset";
                                value-text: Math.round(root.shake-max-offset) + "px";
                                minimum: 5.0;
                                maximum: 120.0;
                                value: root.shake-max-offset;
                                changed(val) => { root.shake-max-offset = Math.round(val); root.config-changed(); }
                            }
                            CheckBox {
                                text: "Shake only on beats";
                                checked: root.shake-on-beat;
                                toggled => { root.shake-on-beat = self.checked; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Glitch") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Glitch Intensity";
                                value-text: Math.round(root.glitch-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.glitch-intensity;
                                changed(val) => { root.glitch-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Vignette") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Vignette Intensity";
                                value-text: Math.round(root.vignette-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.vignette-intensity;
                                changed(val) => { root.vignette-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Pulse") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Pulse Strength";
                                value-text: Math.round(root.pulse-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.pulse-intensity;
                                changed(val) => { root.pulse-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Spotlight") : VerticalLayout {
                            spacing: 10px;
                            ColorPickerField {
                                label: "Spotlight Color";
                                hex-val: root.spotlight-color;
                                changed(val) => { root.spotlight-color = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Strobe") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Strobe Intensity";
                                value-text: Math.round(root.strobe-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.strobe-intensity;
                                changed(val) => { root.strobe-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Scanline") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Scanline Opacity";
                                value-text: Math.round(root.scanline-opacity * 100) + "%";
                                minimum: 0.0;
                                maximum: 0.5;
                                value: root.scanline-opacity;
                                changed(val) => { root.scanline-opacity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Chromatic Aberration") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Chromatic Intensity";
                                value-text: Math.round(root.chromatic-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.chromatic-intensity;
                                changed(val) => { root.chromatic-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Zoom") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Zoom Intensity";
                                value-text: Math.round(root.zoom-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 0.5;
                                value: root.zoom-intensity;
                                changed(val) => { root.zoom-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Invert") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Invert Intensity";
                                value-text: Math.round(root.invert-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.invert-intensity;
                                changed(val) => { root.invert-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Bars") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Bars Amount";
                                value-text: Math.round(root.bars-amount * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.bars-amount;
                                changed(val) => { root.bars-amount = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Shockwave") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Shockwave Intensity";
                                value-text: Math.round(root.shockwave-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.shockwave-intensity;
                                changed(val) => { root.shockwave-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Pixelate") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Pixelate Intensity";
                                value-text: Math.round(root.pixelate-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.pixelate-intensity;
                                changed(val) => { root.pixelate-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Tilt") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Tilt Intensity";
                                value-text: Math.round(root.tilt-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.tilt-intensity;
                                changed(val) => { root.tilt-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Heat Haze") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Heat Haze Intensity";
                                value-text: Math.round(root.heat-haze-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.heat-haze-intensity;
                                changed(val) => { root.heat-haze-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Hue Shift") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Hue Shift Intensity";
                                value-text: Math.round(root.hue-shift-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.hue-shift-intensity;
                                changed(val) => { root.hue-shift-intensity = val; root.config-changed(); }
                            }
                        }

                        if (root.main-effect == "Glass Crack") : VerticalLayout {
                            spacing: 10px;
                            SliderRow {
                                label: "Glass Crack Intensity";
                                value-text: Math.round(root.glass-crack-intensity * 100) + "%";
                                minimum: 0.0;
                                maximum: 1.0;
                                value: root.glass-crack-intensity;
                                changed(val) => { root.glass-crack-intensity = val; root.config-changed(); }
                            }
                        }
                    }
                }

                // TEXT OVERLAY TAB
                if (root.active-tab == "text") : VerticalLayout {
                    spacing: 10px;
                    SectionTitle { text: "SONG METADATA & TYPOGRAPHY"; }

                    CheckBox {
                        text: "Display Song Title";
                        checked: root.show-title;
                        toggled => { root.show-title = self.checked; root.config-changed(); }
                    }

                    LineEdit {
                        text: root.track-title;
                        placeholder-text: "Song Title";
                        edited(val) => { root.track-title = val; root.config-changed(); }
                    }

                    CheckBox {
                        text: "Display Artist Name";
                        checked: root.show-artist;
                        toggled => { root.show-artist = self.checked; root.config-changed(); }
                    }

                    LineEdit {
                        text: root.track-artist;
                        placeholder-text: "Artist Name";
                        edited(val) => { root.track-artist = val; root.config-changed(); }
                    }

                    SectionTitle { text: "DYNAMIC CUSTOM TEXT OVERLAYS"; }

                    Button {
                        text: "+ Add Custom Text";
                        height: 36px;
                        clicked => { root.add-custom-text-clicked(); }
                    }

                    for block[idx] in root.custom-text-blocks : Rectangle {
                        background: #ffffff0a;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #ffd70030;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;
                                CheckBox {
                                    text: "Enable Text #" + (idx + 1);
                                    checked: block.enabled;
                                    toggled => {
                                        root.custom-text-edited(block.id, block.text, self.checked, block.pos_x, block.pos_y, block.font_size, block.font_family, block.font_weight, block.color_hex);
                                    }
                                }
                                Rectangle { horizontal-stretch: 1.0; }
                                Button {
                                    text: "Remove";
                                    height: 28px;
                                    clicked => { root.remove-custom-text-clicked(block.id); }
                                }
                            }

                            LineEdit {
                                text: block.text;
                                placeholder-text: "Custom Text (e.g. CredibleMark Studio)";
                                edited(val) => {
                                    root.custom-text-edited(block.id, val, block.enabled, block.pos_x, block.pos_y, block.font_size, block.font_family, block.font_weight, block.color_hex);
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Font Variant:";
                                    color: #a3a3a3;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    height: 30px;
                                    horizontal-stretch: 1.0;
                                    model: ["Inter", "Roboto", "Outfit", "Serif", "Monospace"];
                                    current-value: block.font_family;
                                    selected(val) => {
                                        root.custom-text-edited(block.id, block.text, block.enabled, block.pos_x, block.pos_y, block.font_size, val, block.font_weight, block.color_hex);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: "Font Weight:";
                                    color: #a3a3a3;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    height: 30px;
                                    horizontal-stretch: 1.0;
                                    model: ["Normal", "Bold", "Heavy"];
                                    current-value: block.font_weight;
                                    selected(val) => {
                                        root.custom-text-edited(block.id, block.text, block.enabled, block.pos_x, block.pos_y, block.font_size, block.font_family, val, block.color_hex);
                                    }
                                }
                            }

                            SliderRow {
                                label: "Pos X";
                                value-text: Math.round(block.pos_x) + "%";
                                minimum: 0.0;
                                maximum: 100.0;
                                value: block.pos_x;
                                changed(val) => {
                                    root.custom-text-edited(block.id, block.text, block.enabled, val, block.pos_y, block.font_size, block.font_family, block.font_weight, block.color_hex);
                                }
                            }

                            SliderRow {
                                label: "Pos Y";
                                value-text: Math.round(block.pos_y) + "%";
                                minimum: 0.0;
                                maximum: 100.0;
                                value: block.pos_y;
                                changed(val) => {
                                    root.custom-text-edited(block.id, block.text, block.enabled, block.pos_x, val, block.font_size, block.font_family, block.font_weight, block.color_hex);
                                }
                            }

                            SliderRow {
                                label: "Font Size";
                                value-text: Math.round(block.font_size) + "px";
                                minimum: 10.0;
                                maximum: 120.0;
                                value: block.font_size;
                                changed(val) => {
                                    root.custom-text-edited(block.id, block.text, block.enabled, block.pos_x, block.pos_y, val, block.font_family, block.font_weight, block.color_hex);
                                }
                            }
                        }
                    }

                    SectionTitle { text: "QUICK POSITION PRESET"; }
                    ComboBox {
                        height: 34px;
                        model: ["Bottom Center", "Top Center", "Center", "Bottom Left", "Left Middle", "Right Middle"];
                        current-value: root.text-preset;
                        current-index: root.text-preset == "Bottom Center" ? 0 : root.text-preset == "Top Center" ? 1 : root.text-preset == "Center" ? 2 : root.text-preset == "Bottom Left" ? 3 : root.text-preset == "Left Middle" ? 4 : 5;
                        selected(val) => {
                            root.text-preset = val;
                            if (val == "Bottom Center") {
                                root.title-pos-x = 50.0; root.title-pos-y = 78.0;
                                root.artist-pos-x = 50.0; root.artist-pos-y = 86.0;
                            } else if (val == "Top Center") {
                                root.title-pos-x = 50.0; root.title-pos-y = 12.0;
                                root.artist-pos-x = 50.0; root.artist-pos-y = 20.0;
                            } else if (val == "Center") {
                                root.title-pos-x = 50.0; root.title-pos-y = 45.0;
                                root.artist-pos-x = 50.0; root.artist-pos-y = 55.0;
                            } else if (val == "Bottom Left") {
                                root.title-pos-x = 8.0; root.title-pos-y = 78.0;
                                root.artist-pos-x = 8.0; root.artist-pos-y = 86.0;
                            } else if (val == "Left Middle") {
                                root.title-pos-x = 8.0; root.title-pos-y = 45.0;
                                root.artist-pos-x = 8.0; root.artist-pos-y = 55.0;
                            } else if (val == "Right Middle") {
                                root.title-pos-x = 92.0; root.title-pos-y = 45.0;
                                root.artist-pos-x = 92.0; root.artist-pos-y = 55.0;
                            }
                            root.config-changed();
                        }
                    }

                    SectionTitle { text: "TITLE STYLE & POSITION"; }
                    SliderRow {
                        label: "Title Horizontal X";
                        value-text: Math.round(root.title-pos-x) + "%";
                        minimum: 0.0;
                        maximum: 100.0;
                        value: root.title-pos-x;
                        changed(val) => { root.title-pos-x = Math.round(val); root.config-changed(); }
                    }
                    SliderRow {
                        label: "Title Vertical Y";
                        value-text: Math.round(root.title-pos-y) + "%";
                        minimum: 0.0;
                        maximum: 100.0;
                        value: root.title-pos-y;
                        changed(val) => { root.title-pos-y = Math.round(val); root.config-changed(); }
                    }
                    SliderRow {
                        label: "Title Font Size";
                        value-text: Math.round(root.title-font-size) + "px";
                        minimum: 12.0;
                        maximum: 96.0;
                        value: root.title-font-size;
                        changed(val) => { root.title-font-size = Math.round(val); root.config-changed(); }
                    }
                    ColorPickerField {
                        label: "Title Color";
                        hex-val: root.title-color;
                        changed(val) => { root.title-color = val; root.config-changed(); }
                    }

                    SectionTitle { text: "ARTIST STYLE & POSITION"; }
                    SliderRow {
                        label: "Artist Horizontal X";
                        value-text: Math.round(root.artist-pos-x) + "%";
                        minimum: 0.0;
                        maximum: 100.0;
                        value: root.artist-pos-x;
                        changed(val) => { root.artist-pos-x = Math.round(val); root.config-changed(); }
                    }
                    SliderRow {
                        label: "Artist Vertical Y";
                        value-text: Math.round(root.artist-pos-y) + "%";
                        minimum: 0.0;
                        maximum: 100.0;
                        value: root.artist-pos-y;
                        changed(val) => { root.artist-pos-y = Math.round(val); root.config-changed(); }
                    }
                    SliderRow {
                        label: "Artist Font Size";
                        value-text: Math.round(root.artist-font-size) + "px";
                        minimum: 10.0;
                        maximum: 72.0;
                        value: root.artist-font-size;
                        changed(val) => { root.artist-font-size = Math.round(val); root.config-changed(); }
                    }
                    ColorPickerField {
                        label: "Artist Color";
                        hex-val: root.artist-color;
                        changed(val) => { root.artist-color = val; root.config-changed(); }
                    }
                }
            }
        }
    }
}

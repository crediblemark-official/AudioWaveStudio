import { CustomTextBlockData } from "custom_text.slint";
import { Button, Slider, ComboBox, LineEdit, ScrollView, CheckBox } from "std-widgets.slint";

export struct StyleItem {
    id: string,
    label: string,
    category: string,
}

component StyleVisualIcon inherits Rectangle {
    in property <string> style-id: "";
    in property <color> icon-color: #ffd700;

    width: 24px;
    height: 18px;

    if root.style-id == "spectrum" || root.style-id == "smoothSpectrum" || root.style-id == "waveformBarcodePulse" : HorizontalLayout {
        spacing: 2px;
        alignment: center;
        cross-axis-alignment: end;
        Rectangle { width: 3px; height: 10px; border-radius: 1px; background: root.icon-color; }
        Rectangle { width: 3px; height: 16px; border-radius: 1px; background: root.icon-color; }
        Rectangle { width: 3px; height: 8px; border-radius: 1px; background: root.icon-color; }
        Rectangle { width: 3px; height: 14px; border-radius: 1px; background: root.icon-color; }
    }

    if root.style-id == "radial" || root.style-id == "circularBars" || root.style-id == "pulseRings" || root.style-id == "radialRipple3D" || root.style-id == "vinylRecord" || root.style-id == "orbitSpike" || root.style-id == "cyberRing3D" || root.style-id == "dualPortalBridge" || root.style-id == "cyberBlackHole" || root.style-id == "supernovaBurst" || root.style-id == "quantumEye" || root.style-id == "chronoReactor" || root.style-id == "solarFlareCrown" || root.style-id == "warpDrive" || root.style-id == "neonBiohazard" || root.style-id == "neonLotus" || root.style-id == "holographicVinyl" || root.style-id == "acousticCymascope" || root.style-id == "waveformOscillatingRings" || root.style-id == "radialSpikeBlade" || root.style-id == "radialPlasmaAura" || root.style-id == "radialCyberRune" || root.style-id == "radialNeonOrbiter" || root.style-id == "radialStarlightHalo" || root.style-id == "radialVortexSpiral" || root.style-id == "radialBioShuriken" || root.style-id == "radialHexCore" || root.style-id == "radialSonicMandala" || root.style-id == "radialLaserCurtain" || root.style-id == "radialSolarFlareBurst" || root.style-id == "radialApertureIris" || root.style-id == "radialRadarSweep" || root.style-id == "radialGearMechanism" || root.style-id == "radialFireworksBurst" || root.style-id == "radialKaleidoscope" || root.style-id == "radialOrrery" || root.style-id == "radialClockwork" || root.style-id == "radialGeodesicWeb" || root.style-id == "pulsingPillRing" || root.style-id == "pulsingLiquidAura" || root.style-id == "pulsingDualRing" || root.style-id == "pulsingShockwave" || root.style-id == "pulsingNeonArcade" || root.style-id == "pulsingLaserWeb" || root.style-id == "pulsingCosmicDust" || root.style-id == "pulsingCyberShield" || root.style-id == "pulsingSunburstCorona" || root.style-id == "pulsingBarcodePill" : HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        Rectangle {
            width: 16px;
            height: 16px;
            border-radius: 8px;
            border-width: 2px;
            border-color: root.icon-color;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.icon-color;
            }
        }
    }

    if root.style-id == "oscilloscope" || root.style-id == "minimal" || root.style-id == "auroraWave" || root.style-id == "particleWave3D" || root.style-id == "waterfall3D" || root.style-id == "dualWaveHorizon" || root.style-id == "mercuryFluid" || root.style-id == "quantumRibbon" || root.style-id == "waveformSeismograph" || root.style-id == "waveformDualTube" || root.style-id == "waveformSineComb" || root.style-id == "waveformHarmonicWeb" || root.style-id == "waveformTopographicRibbon" || root.style-id == "waveformCurtainBeams" : HorizontalLayout {
        spacing: 1px;
        alignment: center;
        cross-axis-alignment: center;
        Rectangle { width: 4px; height: 2px; background: root.icon-color; }
        Rectangle { width: 4px; height: 8px; background: root.icon-color; }
        Rectangle { width: 4px; height: 14px; background: root.icon-color; }
        Rectangle { width: 4px; height: 6px; background: root.icon-color; }
        Rectangle { width: 4px; height: 2px; background: root.icon-color; }
    }

    if root.style-id == "equalizer" || root.style-id == "vuMeter" || root.style-id == "laserWall" || root.style-id == "waveformVoxelTerrain" || root.style-id == "waveformSteppedArcade" : HorizontalLayout {
        alignment: center;
        cross-axis-alignment: center;
        GridLayout {
            spacing: 2px;
            Row {
                Rectangle { width: 4px; height: 4px; border-radius: 1px; background: root.icon-color; }
                Rectangle { width: 4px; height: 4px; border-radius: 1px; background: root.icon-color; }
                Rectangle { width: 4px; height: 4px; border-radius: 1px; background: root.icon-color; }
            }
            Row {
                Rectangle { width: 4px; height: 4px; border-radius: 1px; background: root.icon-color; }
                Rectangle { width: 4px; height: 4px; border-radius: 1px; background: root.icon-color; }
                Rectangle { width: 4px; height: 4px; border-radius: 1px; background: root.icon-color; }
            }
        }
    }

    if root.style-id == "waveformFill" || root.style-id == "api3D" : HorizontalLayout {
        spacing: 2px;
        alignment: center;
        cross-axis-alignment: end;
        Rectangle { width: 4px; height: 6px; background: root.icon-color; }
        Rectangle { width: 4px; height: 12px; background: root.icon-color; }
        Rectangle { width: 4px; height: 18px; background: root.icon-color; }
        Rectangle { width: 4px; height: 10px; background: root.icon-color; }
    }

    // Default 3D / Audio Stage icon for all other styles
    if root.style-id != "spectrum" && root.style-id != "smoothSpectrum" && root.style-id != "waveformBarcodePulse" && root.style-id != "radial" && root.style-id != "circularBars" && root.style-id != "pulseRings" && root.style-id != "radialRipple3D" && root.style-id != "vinylRecord" && root.style-id != "orbitSpike" && root.style-id != "cyberRing3D" && root.style-id != "dualPortalBridge" && root.style-id != "cyberBlackHole" && root.style-id != "supernovaBurst" && root.style-id != "quantumEye" && root.style-id != "chronoReactor" && root.style-id != "solarFlareCrown" && root.style-id != "warpDrive" && root.style-id != "neonBiohazard" && root.style-id != "neonLotus" && root.style-id != "holographicVinyl" && root.style-id != "acousticCymascope" && root.style-id != "waveformOscillatingRings" && root.style-id != "oscilloscope" && root.style-id != "minimal" && root.style-id != "auroraWave" && root.style-id != "particleWave3D" && root.style-id != "waterfall3D" && root.style-id != "dualWaveHorizon" && root.style-id != "mercuryFluid" && root.style-id != "quantumRibbon" && root.style-id != "waveformSeismograph" && root.style-id != "waveformDualTube" && root.style-id != "waveformSineComb" && root.style-id != "waveformHarmonicWeb" && root.style-id != "waveformTopographicRibbon" && root.style-id != "waveformCurtainBeams" && root.style-id != "equalizer" && root.style-id != "vuMeter" && root.style-id != "laserWall" && root.style-id != "waveformVoxelTerrain" && root.style-id != "waveformSteppedArcade" && root.style-id != "waveformFill" && root.style-id != "api3D" : HorizontalLayout {
        spacing: 3px;
        alignment: center;
        cross-axis-alignment: center;
        Rectangle { width: 5px; height: 12px; border-radius: 1px; background: root.icon-color; }
        Rectangle { width: 5px; height: 16px; border-radius: 1px; background: root.icon-color; }
        Rectangle { width: 5px; height: 10px; border-radius: 1px; background: root.icon-color; }
    }
}

// Legacy .style-card: 2-column grid card with icon + label, gold-tinted on black.
// Micro-interactions: subtle scale + gold glow on hover, stronger glow when
// selected (legacy `box-shadow: 0 0 12px rgba(...,0.2)` + border gold).
component StyleCard inherits Rectangle {
    in property <string> style-id: "";
    in property <string> label: "";
    in property <string> current: "";
    in property <bool> is-visible: true;
    in-out property <bool> has-hover: ta.has-hover;
    callback style-clicked(string);

    visible: root.is-visible;
    height: root.is-visible ? 40px : 0px;
    horizontal-stretch: 1;

    ta := TouchArea {
        width: parent.width;
        height: 34px;
        mouse-cursor: pointer;
        clicked => { root.style-clicked(root.style-id); }

        Rectangle {
            width: parent.width;
            height: 34px;
            border-radius: 6px;
            border-width: 1px;
            border-color: root.current == root.style-id ? #ffd70080 : (root.has-hover ? #ffffff20 : #ffffff0a);
            background: root.current == root.style-id ? #ffd7001a : (root.has-hover ? #ffffff0d : #ffffff04);

            drop-shadow-blur: root.current == root.style-id ? 6px : 0px;
            drop-shadow-color: #ffd70040;
            animate background { duration: 100ms; easing: ease-out; }
            animate border-color { duration: 100ms; easing: ease-out; }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 3px;
                    height: 16px;
                    border-radius: 1.5px;
                    background: root.current == root.style-id ? #ffd700 : transparent;
                }

                StyleVisualIcon {
                    style-id: root.style-id;
                    icon-color: root.current == root.style-id ? #ffd700 : (root.has-hover ? #f8fafc : #94a3b8);
                }

                Text {
                    horizontal-stretch: 1;
                    text: root.label;
                    color: root.current == root.style-id ? #ffd700 : (root.has-hover ? #f8fafc : #cbd5e1);
                    font-size: 12px;
                    font-weight: root.current == root.style-id ? 700 : 500;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.current == root.style-id : Text {
                    text: "✓";
                    color: #ffd700;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Compact segmented tab button (legacy pill-style tab bar): equal-width cells
// with a gold active state, denser than the default widget buttons.
// Micro-interactions: subtle glow + lift on hover; active tab keeps a soft gold
// glow so the current tab reads at a glance (legacy active underline + tint).
component TabBtn inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    height: 30px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: root.active ? #ffd700 : (ta.has-hover ? #ffffff14 : #ffffff06);

        transform-scale-x: ta.has-hover && !root.active ? 1.05 : 1.0;
        transform-scale-y: ta.has-hover && !root.active ? 1.05 : 1.0;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        drop-shadow-blur: root.active ? 10px : (ta.has-hover ? 6px : 0px);
        drop-shadow-color: root.active ? #ffd70080 : #ffd70055;
        animate transform-scale-x { duration: 120ms; easing: ease-out; }
        animate transform-scale-y { duration: 120ms; easing: ease-out; }
        animate drop-shadow-blur { duration: 120ms; easing: ease-out; }

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            alignment: center;

            Text {
                text: root.label;
                color: root.active ? #000000 : (ta.has-hover ? #f8fafc : #a3a3a3);
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        ta := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }

        Tooltip {
            Text { text: root.label; font-size: 11px; color: #f8fafc; }
        }
}

// Legacy `.section-title`: uppercase, bold, muted, letter-spaced. A single line
// with a trailing gold hairline keeps the panel tidy and scannable.
component SectionTitle {
    in property <string> text: "";

    HorizontalLayout {
        spacing: 8px;
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: root.text;
            color: #a3a3a3;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        Rectangle {
            horizontal-stretch: 1;
            height: 1px;
            background: #ffffff14;
        }
    }
}

// Compact slider row: label on the left, live value on the right (gold), track
// below. Replaces the previous label-above-track layout that wasted a row per
// control and made the panel feel cluttered.
component SliderRow {
    in property <string> label: "";
    in property <string> value-text: "";
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    // `value` is deliberately `in`-only: callers bind it one-way (`value: root.x`)
    // and update the same property in their `changed` handler, so the binding
    // stays live and the slider re-syncs — writing back here would break it.
    in property <float> value: 0.0;
    // default-value: the value to restore when the user clicks reset.
    in property <float> default-value: 0.0;
    callback changed(float);

    VerticalLayout {
        spacing: 2px;

        HorizontalLayout {
            spacing: 6px;

            Text {
                text: root.label;
                color: #a3a3a3;
                font-size: 11px;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: root.value-text;
                color: #ffd700;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }

            // Reset button — always visible, glows on hover
            reset-btn := Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: reset-ta.has-hover ? #ffffff18 : transparent;
                border-width: 1px;
                border-color: reset-ta.has-hover ? #ffffff44 : transparent;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                Text {
                    text: "↺";
                    font-size: 11px;
                    color: reset-ta.has-hover ? #ffd700 : #606060;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate color { duration: 150ms; }
                }

                reset-ta := TouchArea {
                    clicked => {
                        root.changed(root.default-value);
                    }
                }
            }
        }

        Slider {
            minimum: root.minimum;
            maximum: root.maximum;
            value: root.value;
            changed(val) => { root.changed(val); }
        }
    }
}


component ColorCanvas2D inherits Rectangle {
    in-out property <string> hex-val: "#ff0000";
    in-out property <float> hue-pos: 0.0;
    in-out property <float> sat-x: 0.9;
    in-out property <float> val-y: 0.1;
    callback changed(string);

    // Live color computed from the pointer state (HSV -> RGB), used by the
    // preview badge and rendered inside the sat/val box. Degrees for `hsv()`
    // are 0..360, s/v/a are 0..1.
    in-out property <color> spectrum-color:
        root.val-y > 0.90 ? #000000
        : root.sat-x < 0.10 && root.val-y < 0.10 ? #ffffff
        : hsv(root.hue-pos * 360.0, root.sat-x.clamp(0.0, 1.0), (1.0 - root.val-y).clamp(0.0, 1.0), 1.0);

    height: 160px;

    HorizontalLayout {
        spacing: 10px;

        // 1. 2D SATURATION & BRIGHTNESS GRADIENT CANVAS
        sat-val-box := Rectangle {
            horizontal-stretch: 1;
            height: 160px;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ffffff33;
            clip: true;

            // Pure Hue Base Background Color — continuous hue (not stepped
            // bands) so dragging is smooth and matches the computed RGB above.
            background: hsv(root.hue-pos * 360.0, 1.0, 1.0);

            // Saturation Overlay: White to Transparent (Left to Right)
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: @linear-gradient(90deg, #ffffff 0%, #ffffff00 100%);
            }

            // Value/Brightness Overlay: Transparent to Black (Top to Bottom)
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
            }

            // 2D TouchArea
            sat-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                moved => {
                    if (self.pressed) {
                        root.sat-x = (self.mouse-x / self.width).clamp(0.0, 1.0);
                        root.val-y = (self.mouse-y / self.height).clamp(0.0, 1.0);
                        root.update-color();
                    }
                }
                pointer-event(evt) => {
                    if (evt.kind == PointerEventKind.down) {
                        root.sat-x = (self.mouse-x / self.width).clamp(0.0, 1.0);
                        root.val-y = (self.mouse-y / self.height).clamp(0.0, 1.0);
                        root.update-color();
                    }
                }
            }

            // Circular Drag Handle Ring ⭕ (Left 2D Box)
            Rectangle {
                x: (root.sat-x * parent.width - 8px).clamp(0px, parent.width - 16px);
                y: (root.val-y * parent.height - 8px).clamp(0px, parent.height - 16px);
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 3px;
                border-color: #ffffff;
                drop-shadow-blur: 4px;
                drop-shadow-color: #000000aa;
            }
        }

        // 2. VERTICAL HUE SPECTRUM RAINBOW SLIDER BAR
        hue-bar := Rectangle {
            width: 22px;
            height: 160px;
            border-radius: 11px;
            border-width: 1px;
            border-color: #ffffff33;
            clip: true;
            background: @linear-gradient(180deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%);

            hue-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                moved => {
                    if (self.pressed) {
                        root.hue-pos = (self.mouse-y / self.height).clamp(0.0, 1.0);
                        root.update-color();
                    }
                }
                pointer-event(evt) => {
                    if (evt.kind == PointerEventKind.down) {
                        root.hue-pos = (self.mouse-y / self.height).clamp(0.0, 1.0);
                        root.update-color();
                    }
                }
            }

            // Circular Drag Handle Ring ⭕ (Right Vertical Bar)
            Rectangle {
                x: 2px;
                y: (root.hue-pos * (parent.height - 18px)).clamp(0px, parent.height - 18px);
                width: 18px;
                height: 18px;
                border-radius: 9px;
                border-width: 3px;
                border-color: #ffffff;
                drop-shadow-blur: 4px;
                drop-shadow-color: #000000aa;
            }
        }
    }

    // ---- Accurate HSV -> RGB -> hex conversion ----
    // hue-pos in 0..1 -> degrees for HSV; sat-x = saturation (0=right edge
    // white, 1=full), val-y = bottom-black (value = 1 - val-y).
    function ch-rr(c: float, x: float, m: float, i: float) -> float {
        return (i == 0 ? c : i == 1 ? x : i == 2 ? 0.0 : i == 3 ? 0.0 : i == 4 ? x : c) + m;
    }
    function ch-gg(c: float, x: float, m: float, i: float) -> float {
        return (i == 0 ? x : i == 1 ? c : i == 2 ? c : i == 3 ? x : i == 4 ? 0.0 : 0.0) + m;
    }
    function ch-bb(c: float, x: float, m: float, i: float) -> float {
        return (i == 0 ? 0.0 : i == 1 ? 0.0 : i == 2 ? x : i == 3 ? c : i == 4 ? c : x) + m;
    }
    function clamp-01(v: float) -> float { return v < 0.0 ? 0.0 : v > 1.0 ? 1.0 : v; }

    // Integer 0..255 -> two hex chars (#RRGGBB).
    function hex-digit(d: float) -> string {
        return d == 0 ? "0" : d == 1 ? "1" : d == 2 ? "2" : d == 3 ? "3" : d == 4 ? "4"
            : d == 5 ? "5" : d == 6 ? "6" : d == 7 ? "7" : d == 8 ? "8" : d == 9 ? "9"
            : d == 10 ? "a" : d == 11 ? "b" : d == 12 ? "c" : d == 13 ? "d" : d == 14 ? "e" : "f";
    }
    function hex2(v: float) -> string {
        let n = Math.round(v);
        return hex-digit(Math.floor(n / 16.0)) + hex-digit(n - Math.floor(n / 16.0) * 16.0);
    }

    function update-color() {
        // Corner snaps: pure black at very bottom, pure white at very top-left.
        if (root.val-y > 0.94) {
            root.hex-val = "#000000";
        } else if (root.sat-x < 0.08 && root.val-y < 0.08) {
            root.hex-val = "#ffffff";
        } else {
            let v = 1.0 - root.val-y;
            let s = root.sat-x;
            let h = root.hue-pos * 360.0;
            let c = v * s;
            let hp = h / 60.0;
            let sect = Math.floor(hp);
            let x = c * (1.0 - Math.abs(Math.mod(hp, 2.0) - 1.0));
            let m = v - c;
            let r = root.clamp-01(root.ch-rr(c, x, m, sect));
            let g = root.clamp-01(root.ch-gg(c, x, m, sect));
            let b = root.clamp-01(root.ch-bb(c, x, m, sect));
            root.hex-val = "#" + hex2(r * 255.0) + hex2(g * 255.0) + hex2(b * 255.0);
        }
        root.changed(root.hex-val);
    }
}

component ColorPickerField inherits Rectangle {
    in property <string> label: "";
    in-out property <string> hex-val: "#00f0ff";
    in-out property <bool> show-canvas: true;
    callback changed(string);

    background: #ffffff05;
    border-radius: 8px;
    border-width: 1px;
    border-color: #ffffff14;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // Label Header & Live Visual Color Box Preview
        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;

            Text {
                text: root.label;
                color: #f1f5f9;
                font-size: 11px;
                font-weight: 700;
            }

            Rectangle { horizontal-stretch: 1; }

            // Live Color Box Badge — reflects the CURRENT color. Known preset hex
// strings map to a real color; for any other (custom/typed) value the badge
// tracks the live HSV->RGB color the user is dragging on the canvas (a plain
// `#RRGGBB` string cannot be re-parsed to a color at runtime in Slint).
            Rectangle {
                width: 26px;
                height: 20px;
                border-radius: 5px;
                border-width: 1px;
                border-color: #ffffff55;
                background: root.hex-val == "#00f0ff" ? #00f0ff
                          : root.hex-val == "#ff007f" ? #ff007f
                          : root.hex-val == "#ffe600" ? #ffe600
                          : root.hex-val == "#9333ea" ? #9333ea
                          : root.hex-val == "#10b981" ? #10b981
                          : root.hex-val == "#ef4444" ? #ef4444
                          : root.hex-val == "#f97316" ? #f97316
                          : root.hex-val == "#3b82f6" ? #3b82f6
                          : root.hex-val == "#ec4899" ? #ec4899
                          : root.hex-val == "#00ff99" ? #00ff99
                          : root.hex-val == "#7c3aed" ? #7c3aed
                          : root.hex-val == "#f59e0b" ? #f59e0b
                          : root.hex-val == "#ff6b6b" ? #ff6b6b
                          : root.hex-val == "#84cc16" ? #84cc16
                          : root.hex-val == "#ffffff" ? #ffffff
                          : root.hex-val == "#000000" ? #000000
                          : color-canvas-badge.spectrum-color;
            }
        }

        // FULL 2D COLOR PICKER CANVAS (Sat/Val 2D Box + Vertical Rainbow Bar)
        color-canvas-badge := ColorCanvas2D {
            hex-val: root.hex-val;
            changed(c) => {
                root.hex-val = c;
                root.changed(c);
            }
        }

        // Custom Hex Input Field & Direct Editing
        HorizontalLayout {
            spacing: 6px;

            Text {
                text: "Hex:";
                color: #94a3b8;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }

            LineEdit {
                horizontal-stretch: 1;
                text: root.hex-val;
                placeholder-text: "#RRGGBB";
                edited(val) => {
                    root.hex-val = val;
                    root.changed(val);
                }
            }
        }
    }
}

export component ControlPanel inherits Rectangle {
    width: 380px; // legacy .control-panel width
    background: #0a0a0a;

    in-out property <string> active-tab: "style";
    in-out property <string> style-val: "spectrum";
    in-out property <int> bar-count: 64;
    in-out property <float> bar-gap: 2.0;
    in-out property <float> bar-width: 6.0;
    in-out property <float> bar-rounding: 2.0;
    in-out property <bool> mirror-bars: false;
    in-out property <float> sensitivity: 1.2;
    in-out property <float> smoothing: 0.8;
    in-out property <float> bass-multiplier: 1.5;
    in-out property <float> fire-width-ratio: 0.94;
    in-out property <float> fire-height-scale: 1.0;
    in-out property <string> radial-center-image-uri: "";
    in-out property <float> visualizer-scale: 1.0;
    in-out property <float> position-x: 0.0;
    in-out property <float> position-y: 0.0;

    in-out property <string> theme-name: "Cyberpunk";
    in-out property <string> primary-color: "#00f0ff";
    in-out property <string> secondary-color: "#ff007f";
    in-out property <string> accent-color: "#ffe600";
    in-out property <string> glow-color: "#00f0ff";
    in-out property <bool> show-peaks: false;
    in-out property <string> peak-color: "#ffffff";

    in-out property <string> bg-mode: "Gradient";
    in-out property <string> solid-color: "#090a0f";
    in-out property <string> gradient-start: "#0f0c20";
    in-out property <string> gradient-end: "#06101e";
    in-out property <float> blur-amount: 0.0;
    in-out property <float> overlay-opacity: 0.3;
    in-out property <float> image-opacity: 1.0;
    in-out property <string> custom-bg-name: "";
    in-out property <bool> show-particles: true;
    in-out property <bool> show-music-notes: false;
    in-out property <bool> show-fireworks: false;
    in-out property <bool> show-matrix-rain: false;
    in-out property <bool> show-fireflies: false;
    in-out property <bool> show-sakura: false;
    in-out property <bool> show-cyber-lightning: false;
    in-out property <float> grid-size: 40.0;
    in-out property <float> grid-line-width: 1.0;
    in-out property <string> grid-color: "#ffffff";
    in-out property <string> particle-style: "Float";

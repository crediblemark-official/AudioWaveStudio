        { id: "TacticalHud", label: "Tactical HUD", category: "cyber" },
        { id: "CrystalPrism", label: "Crystal Prism", category: "3d" },
        { id: "SynthwaveSun", label: "Synthwave Sun", category: "retro" },
        { id: "BiomorphicBloom", label: "Biomorphic Bloom", category: "liquid" },
        { id: "InfinityLoop", label: "Infinity Loop", category: "radial" },
        { id: "liquidTriLobeAura", label: "Tri-Lobe Aura", category: "liquid" },
        { id: "liquidFerrofluidSpikes", label: "Ferrofluid Spikes", category: "liquid" },
        { id: "liquidMoltenMercury", label: "Molten Mercury", category: "liquid" },
        { id: "liquidConcentricDrop", label: "Concentric Drop", category: "liquid" },
        { id: "liquidJellyfishTentacles", label: "Jellyfish Tentacles", category: "liquid" },
        { id: "liquidOilSlick", label: "Iridescent Oil Slick", category: "liquid" },
        { id: "liquidVortexSwirl", label: "Vortex Swirl", category: "liquid" },
        { id: "liquidMetaballLava", label: "Metaball Lava", category: "liquid" },
        { id: "liquidToxicSlime", label: "Toxic Slime", category: "liquid" },
        { id: "liquidCymascopeWater", label: "Cymascope Water", category: "liquid" },
        { id: "liquidBioluminescentPlasma", label: "Bio Plasma", category: "liquid" },
        { id: "liquidPlasmaBlob3D", label: "Plasma Blob 3D", category: "liquid" },
        { id: "liquidChromaticViscosity", label: "Chromatic Viscosity", category: "liquid" },
        { id: "liquidHydroElectricArcs", label: "Hydro-Electric Arcs", category: "liquid" },
        { id: "liquidBioluminescentPlankton", label: "Bioluminescent Plankton", category: "liquid" },
        { id: "liquidRadioactiveIsotope", label: "Solar Wind Storm", category: "liquid" },
        { id: "liquidNeonCyberGoo", label: "Neon Cyber Goo", category: "liquid" },
        { id: "liquidMoltenGoldStream", label: "Molten Gold Stream", category: "liquid" },
        { id: "liquidMagmaCrustCore", label: "Magma Crust Core", category: "liquid" },
        { id: "liquidQuantumFluid", label: "Quantum Fluid", category: "liquid" },
        { id: "glassBoxQuantumPlasma", label: "Glass Box: Quantum", category: "glass" },
        { id: "glassBoxNeonSpectrum", label: "Glass Box: Spectrum", category: "glass" },
        { id: "glassBoxCyberGrid", label: "Glass Box: Cyber Grid", category: "glass" },
        { id: "glassBoxBioluminescentJellyfish", label: "Glass Box: Bio Jellyfish", category: "glass" },
        { id: "glassBoxMoltenLava", label: "Glass Box: Lava Lamp", category: "glass" },
        { id: "glassBoxLaserMatrix", label: "Glass Box: Laser Matrix", category: "glass" },
        { id: "glassBoxLiquidChrome", label: "Glass Box: Liquid Chrome", category: "glass" },
        { id: "glassBoxCosmicNebula", label: "Glass Box: Nebula", category: "glass" },
        { id: "glassBoxHologramCore", label: "Glass Box: Hologram Core", category: "glass" },
        { id: "glassBoxMatrixRain", label: "Glass Box: Matrix Rain", category: "glass" },
    ];

    in-out property <[StyleItem]> visible-style-items: root.style-items;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        // TAB BAR — compact segmented pills (legacy .tabs)
        HorizontalLayout {
            spacing: 4px;

            TabBtn { label: "Style"; active: root.active-tab == "style"; clicked => { root.active-tab = "style"; } }
            TabBtn { label: "Colors"; active: root.active-tab == "colors"; clicked => { root.active-tab = "colors"; } }
            TabBtn { label: "Bg"; active: root.active-tab == "background"; clicked => { root.active-tab = "background"; } }
            TabBtn { label: "FX"; active: root.active-tab == "effects"; clicked => { root.active-tab = "effects"; } }
            TabBtn { label: "Text"; active: root.active-tab == "text"; clicked => { root.active-tab = "text"; } }
        }

        // TAB CONTENT AREA
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: start;
                padding: 10px;
                spacing: 12px;

                // STYLE TAB
                if (root.active-tab == "style") : VerticalLayout {
                    spacing: 10px;

                    // SEARCH INPUT BAR
                    HorizontalLayout {
                        spacing: 6px;
                        height: 34px;

                        Rectangle {
                            background: #1e1e2d;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #ffd70066;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                spacing: 6px;

                                Text {
                                    text: "🔍";
                                    font-size: 13px;
                                    color: #ffd700;
                                    vertical-alignment: center;
                                }

                                LineEdit {
                                    placeholder-text: "Search style name...";
                                    text <=> root.style-search-query;
                                }
                            }
                        }
                    }

                    // Category tab bar with horizontal scrolling
                    ScrollView {
                        height: 34px;

                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;

                            TabBtn { label: "All"; active: root.style-category == "all"; clicked => { root.style-category = "all"; } }
                            TabBtn { label: "Wave"; active: root.style-category == "waveform"; clicked => { root.style-category = "waveform"; } }
                            TabBtn { label: "Radial"; active: root.style-category == "radial"; clicked => { root.style-category = "radial"; } }
                            TabBtn { label: "3D"; active: root.style-category == "3d"; clicked => { root.style-category = "3d"; } }
                            TabBtn { label: "Retro"; active: root.style-category == "retro"; clicked => { root.style-category = "retro"; } }
                            TabBtn { label: "Cyber"; active: root.style-category == "cyber"; clicked => { root.style-category = "cyber"; } }
                            TabBtn { label: "Liquid"; active: root.style-category == "liquid"; clicked => { root.style-category = "liquid"; } }
                            TabBtn { label: "Pulse"; active: root.style-category == "pulsing"; clicked => { root.style-category = "pulsing"; } }
                            TabBtn { label: "Space"; active: root.style-category == "space"; clicked => { root.style-category = "space"; } }
                            TabBtn { label: "Glass"; active: root.style-category == "glass"; clicked => { root.style-category = "glass"; } }
                        }
                    }

                    VerticalLayout {
                        spacing: 0px;
                        alignment: start;
                        for item in root.style-items : StyleCard {
                            is-visible: root.matches-search(item.label, root.style-search-query) && root.matches-category(item.category, root.style-category);
                            style-id: item.id;
                            label: item.label;
                            current: root.style-val;
                            style-clicked(id) => { root.style-val = id; root.config-changed(); }
                        }
                    }
                    if (root.has-bar-count(root.style-val)) : SliderRow {
                        label: "Bar Count";
                        value-text: "" + root.bar-count;
                        minimum: 16;
                        maximum: 128;
                        default-value: 64;
                        value: root.bar-count;
                        changed(val) => { root.bar-count = Math.round(val); root.config-changed(); }
                    }

                    if (root.style-val == "spectrum") : VerticalLayout {
                        spacing: 10px;
                        SliderRow {
                            label: "Bar Gap";
                            value-text: root.bar-gap + "px";
                            minimum: 0;
                            maximum: 20;
                            default-value: 2;
                            value: root.bar-gap;
                            changed(val) => { root.bar-gap = Math.round(val); root.config-changed(); }
                        }

                        SliderRow {
                            label: "Bar Width";
                            value-text: root.bar-width + "px";
                            minimum: 2;
                            maximum: 40;
                            default-value: 6;
                            value: root.bar-width;
                            changed(val) => { root.bar-width = Math.round(val); root.config-changed(); }
                        }

                        SliderRow {
                            label: "Bar Rounding";
                            value-text: root.bar-rounding + "px";
                            minimum: 0;
                            maximum: 20;
                            default-value: 3;
                            value: root.bar-rounding;
                            changed(val) => { root.bar-rounding = Math.round(val); root.config-changed(); }
                        }
                    }

                    if (root.style-val == "spectrum" || root.style-val == "smoothSpectrum" || root.style-val == "equalizer" || root.style-val == "waveformFill") : VerticalLayout {
                        spacing: 10px;
                        CheckBox {
                            text: "Mirror Waves Downwards";
                            checked: root.mirror-bars;
                            toggled => { root.mirror-bars = self.checked; root.config-changed(); }
                        }
                        Text { text: "Reflects the visualization symmetrically below the center line"; color: #737373; font-size: 11px; }
                    }

                    SliderRow {
                        label: "Sensitivity";
                        value-text: "" + (Math.round(root.sensitivity * 10) / 10);
                        minimum: 0.2;
                        maximum: 3.0;
                        default-value: 1.0;
                        value: root.sensitivity;
                        changed(val) => { root.sensitivity = val; root.config-changed(); }
                    }

                    SliderRow {
                        label: "Bass Boost";
                        value-text: "" + (Math.round(root.bass-multiplier * 10) / 10);
                        minimum: 0.5;
                        maximum: 4.0;
                        default-value: 1.0;
                        value: root.bass-multiplier;
                        changed(val) => { root.bass-multiplier = val; root.config-changed(); }
                    }

                    SliderRow {
                        label: "Smoothing";
                        value-text: "" + (Math.round(root.smoothing * 100) / 100);
                        minimum: 0.0;
                        maximum: 0.95;
                        default-value: 0.75;
                        value: root.smoothing;
                        changed(val) => { root.smoothing = val; root.config-changed(); }
                    }

                    if (root.style-val == "api3D") : VerticalLayout {
                        spacing: 10px;
                        SliderRow {
                            label: "Fire Wave Width";
                            value-text: Math.round(root.fire-width-ratio * 100) + "%";
                            minimum: 0.3;
                            maximum: 1.0;
                            default-value: 0.75;
                            value: root.fire-width-ratio;
                            changed(val) => { root.fire-width-ratio = val; root.config-changed(); }
                        }

                        SliderRow {
                            label: "Fire Wave Height";
                            value-text: "" + (Math.round(root.fire-height-scale * 10) / 10) + "x";
                            minimum: 0.3;
                            maximum: 2.5;
                            default-value: 1.0;
                            value: root.fire-height-scale;
                            changed(val) => { root.fire-height-scale = val; root.config-changed(); }
                        }
                    }

                    SliderRow {
                        label: "Visualizer Scale";
                        value-text: "" + (Math.round(root.visualizer-scale * 10) / 10);
                        minimum: 0.2;
                        maximum: 3.0;
                        default-value: 1.0;
                        value: root.visualizer-scale;
                        changed(val) => { root.visualizer-scale = val; root.config-changed(); }
                    }

                    SliderRow {
                        label: "Position X (Left / Right)";
                        value-text: Math.round(root.position-x * 100) + "%";
                        minimum: -1.0;
                        maximum: 1.0;
                        default-value: 0.0;
                        value: root.position-x;
                        changed(val) => { root.position-x = val; root.config-changed(); }
                    }

                    SliderRow {
                        label: "Position Y (Up / Down)";
                        value-text: Math.round(root.position-y * 100) + "%";
                        minimum: -1.0;
                        maximum: 1.0;
                        default-value: 0.0;
                        value: root.position-y;
                        changed(val) => { root.position-y = val; root.config-changed(); }
                    }

                    // RADIAL CENTER IMAGE — only shown for styles that implement
                    // draw_radial_center_image() in their Rust renderer.
                    // Excluded: dualPortalBridge (dual portals, no single center),
                    //           radialRipple3D (3D tilt perspective — no meaningful visual center).
                    if (root.style-val == "radial" || root.style-val == "circularBars" || root.style-val == "pulseRings" || root.style-val == "cyberRing3D" || root.style-val == "cyberBlackHole" || root.style-val == "chronoReactor" || root.style-val == "quantumEye" || root.style-val == "neonBiohazard" || root.style-val == "neonLotus" || root.style-val == "holographicVinyl" || root.style-val == "acousticCymascope" || root.style-val == "waveformOscillatingRings" || root.style-val == "warpDrive" || root.style-val == "solarFlareCrown" || root.style-val == "supernovaBurst" || root.style-val == "speakerExplosion" || root.style-val == "turntable" || root.style-val == "vinylRecord" || root.style-val == "radialSpikeBlade" || root.style-val == "radialPlasmaAura" || root.style-val == "radialCyberRune" || root.style-val == "radialNeonOrbiter" || root.style-val == "radialStarlightHalo" || root.style-val == "radialVortexSpiral" || root.style-val == "radialBioShuriken" || root.style-val == "radialHexCore" || root.style-val == "radialSonicMandala" || root.style-val == "radialLaserCurtain" || root.style-val == "radialSolarFlareBurst" || root.style-val == "radialApertureIris" || root.style-val == "radialRadarSweep" || root.style-val == "radialGearMechanism" || root.style-val == "radialFireworksBurst" || root.style-val == "radialKaleidoscope" || root.style-val == "radialOrrery" || root.style-val == "radialClockwork" || root.style-val == "radialGeodesicWeb" || root.style-val == "pulsingPillRing" || root.style-val == "pulsingLiquidAura" || root.style-val == "pulsingDualRing" || root.style-val == "pulsingShockwave" || root.style-val == "pulsingNeonArcade" || root.style-val == "pulsingLaserWeb" || root.style-val == "pulsingCosmicDust" || root.style-val == "pulsingCyberShield" || root.style-val == "pulsingSunburstCorona" || root.style-val == "pulsingBarcodePill") : VerticalLayout {
                        spacing: 8px;
                        SectionTitle { text: "RADIAL CENTER IMAGE"; }
                        Button {
                            text: root.radial-center-image-uri == "" ? "Choose Center Image" : "Change Center Image";
                            clicked => { root.open-radial-image-clicked(); }
                        }
                        if (root.radial-center-image-uri != "") : Button {
                            text: "Remove Image";
                            clicked => { root.remove-radial-image-clicked(); }
                        }
                    }
                }

                // COLORS TAB
                if (root.active-tab == "colors") : VerticalLayout {
                    spacing: 10px;
                    SectionTitle { text: "COLOR THEME PRESETS"; }
                    ComboBox {
                        height: 34px;
                        model: ["Cyberpunk", "Synthwave", "Emerald", "Violet", "Gold", "Custom"];
                        current-value: root.theme-name;
                        current-index: root.theme-name == "Cyberpunk" ? 0 : root.theme-name == "Synthwave" ? 1 : root.theme-name == "Emerald" ? 2 : root.theme-name == "Violet" ? 3 : root.theme-name == "Gold" ? 4 : 5;
                        selected(val) => { root.theme-name = val; root.theme-preset-selected(val); }
                    }
                    Button {
                        text: "↺ Reset Colors";
                        enabled: root.theme-name != "Custom";
                        clicked => { root.theme-preset-selected(root.theme-name); }
                    }
                    if (root.theme-name == "Custom") : Text {
                        text: "Reset is disabled while Custom is selected";
                        color: #737373;
                        font-size: 11px;
                    }

                    SectionTitle { text: "CUSTOM COLORS & PALETTE"; }

                    ColorPickerField {
                        label: "Primary Color";
                        hex-val: root.primary-color;
                        changed(val) => { root.primary-color = val; root.config-changed(); }
                    }

                    ColorPickerField {
                        label: "Secondary Color";
                        hex-val: root.secondary-color;
                        changed(val) => { root.secondary-color = val; root.config-changed(); }
                    }

                    ColorPickerField {
                        label: "Accent Color";
                        hex-val: root.accent-color;
                        changed(val) => { root.accent-color = val; root.config-changed(); }
                    }

                    ColorPickerField {
                        label: "Glow Color";
                        hex-val: root.glow-color;
                        changed(val) => { root.glow-color = val; root.config-changed(); }
                    }

                    SectionTitle { text: "PEAK MARKERS"; }
                    CheckBox {
                        text: "Show Dynamic Peak Drop Markers";
                        checked: root.show-peaks;
                        toggled => { root.show-peaks = self.checked; root.config-changed(); }
                    }
                    if (root.show-peaks) : VerticalLayout {
                        spacing: 10px;
                        ColorPickerField {
                            label: "Peak Marker Color";
                            hex-val: root.peak-color;
                            changed(val) => { root.peak-color = val; root.config-changed(); }
                        }
                    }
                }

                // BACKGROUND TAB
                if (root.active-tab == "background") : VerticalLayout {
                    spacing: 10px;
                    SectionTitle { text: "BACKGROUND FILL & EFFECT STYLE"; }
                    ComboBox {
                        height: 34px;
                        model: ["Solid", "Gradient", "Grid", "Aurora", "Noise", "Bokeh", "Starfield", "Nebula", "Psychedelic"];
                        current-value: root.bg-mode;
                        current-index: root.bg-mode == "Solid" ? 0 : root.bg-mode == "Gradient" ? 1 : root.bg-mode == "Grid" ? 2 : root.bg-mode == "Aurora" ? 3 : root.bg-mode == "Noise" ? 4 : root.bg-mode == "Bokeh" ? 5 : root.bg-mode == "Starfield" ? 6 : root.bg-mode == "Nebula" ? 7 : 8;
                        selected(val) => { root.bg-mode = val; root.config-changed(); }
                    }

                    SectionTitle { text: "CUSTOM BACKGROUND IMAGE"; }
                    if (root.custom-bg-name != "") : HorizontalLayout {
                        spacing: 6px;
                        alignment: center;
                        Rectangle {
                            background: #ffd70015;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #ffd70040;

                            HorizontalLayout {
                                padding: 6px;
                                spacing: 6px;
                                alignment: center;
                                Text {
                                    text: "📷 Selected: " + root.custom-bg-name;
                                    font-size: 11px;
                                    color: #ffd700;
                                    font-weight: 600;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: root.custom-bg-name != "" ? "🖼 Change Background Image" : "🖼 Select Background Image";
                            clicked => { root.open-custom-image-clicked(); }
                        }
                        if (root.custom-bg-name != "") : Button {
                            text: "🗑 Remove Image";
                            clicked => { root.remove-custom-image-clicked(); }
                        }
                    }
                    SliderRow {
                        label: "Image Opacity";
                        value-text: Math.round(root.image-opacity * 100) + "%";
                        minimum: 0.0;
                        maximum: 1.0;
                        default-value: 0.15;
                        value: root.image-opacity;
                        changed(val) => { root.image-opacity = val; root.config-changed(); }
                    }

                    SectionTitle { text: "BACKGROUND COLORS"; }

                    if (root.bg-mode == "Gradient") : VerticalLayout {
                        spacing: 10px;

                        ColorPickerField {
                            label: "Gradient Start Color";
                            hex-val: root.gradient-start;
                            changed(val) => { root.gradient-start = val; root.config-changed(); }
                        }

                        ColorPickerField {
                            label: "Gradient End Color";
                            hex-val: root.gradient-end;
                            changed(val) => { root.gradient-end = val; root.config-changed(); }
                        }
                    }

                    if (root.bg-mode != "Gradient") : ColorPickerField {
                        label: "Background Color";
                        hex-val: root.solid-color;
                        changed(val) => { root.solid-color = val; root.config-changed(); }
                    }

                    SliderRow {
                        label: "Canvas Darkening (Overlay)";
                        value-text: Math.round(root.overlay-opacity * 100) + "%";
                        minimum: 0.0;
                        maximum: 1.0;
                        default-value: 0.15;
                        value: root.overlay-opacity;
                        changed(val) => { root.overlay-opacity = val; root.config-changed(); }
                    }

                    // SUB-SLIDERS PER BACKGROUND MODE
                    if (root.bg-mode == "Grid") : VerticalLayout {
                        spacing: 10px;
                        SectionTitle { text: "GRID SETTINGS"; }
                        SliderRow {
                            label: "Grid Size";
                            value-text: Math.round(root.grid-size) + "px";
                            minimum: 10.0;
                            maximum: 120.0;
                            default-value: 40.0;
                            value: root.grid-size;
                            changed(val) => { root.grid-size = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Line Width";
                            value-text: Math.round(root.grid-line-width) + "px";
                            minimum: 1.0;
                            maximum: 6.0;
                            default-value: 1.0;
                            value: root.grid-line-width;
                            changed(val) => { root.grid-line-width = val; root.config-changed(); }
                        }
                        ColorPickerField {
                            label: "Grid Color";
                            hex-val: root.grid-color;
                            changed(val) => { root.grid-color = val; root.config-changed(); }
                        }
                    }

                    if (root.bg-mode == "Starfield") : VerticalLayout {
                        spacing: 10px;
                        SectionTitle { text: "STARFIELD SETTINGS"; }
                        SliderRow {
                            label: "Star Count";
                            value-text: Math.round(root.star-count) + "";
                            minimum: 30.0;
                            maximum: 300.0;
                            default-value: 100.0;
                            value: root.star-count;
                            changed(val) => { root.star-count = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Twinkle Speed";
                            value-text: Math.round(root.star-speed * 100) + "%";
                            minimum: 0.2;
                            maximum: 3.0;
                            default-value: 1.0;
                            value: root.star-speed;
                            changed(val) => { root.star-speed = val; root.config-changed(); }
                        }
                        SliderRow {
                            label: "Brightness";
                            value-text: Math.round(root.star-brightness * 100) + "%";
                            minimum: 0.2;
                            maximum: 1.5;
                            default-value: 1.0;
                            value: root.star-brightness;
                            changed(val) => { root.star-brightness = val; root.config-changed(); }
                        }
                    }

                    if (root.bg-mode == "Nebula") : VerticalLayout {
                        spacing: 10px;
                        SectionTitle { text: "NEBULA SETTINGS"; }
                        SliderRow {
                            label: "Nebula Intensity";
                            value-text: Math.round(root.nebula-intensity * 100) + "%";
                            minimum: 0.1;
                            maximum: 1.0;
                            default-value: 0.5;
                            value: root.nebula-intensity;
                            changed(val) => { root.nebula-intensity = val; root.config-changed(); }

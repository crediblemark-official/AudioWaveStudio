    callback remove-custom-image-clicked();

    callback filter-changed();

    pure callback matches-search(string, string) -> bool;
    pure callback matches-category(string, string) -> bool;
    pure callback has-center-image(string) -> bool;
    pure function has-bar-count(style-id: string) -> bool { return style-id != "oscilloscope"; }

    in-out property <[StyleItem]> style-items: [
        { id: "spectrum", label: "Spectrum Bars", category: "waveform" },

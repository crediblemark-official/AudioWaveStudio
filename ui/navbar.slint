import { Button } from "std-widgets.slint";

// Compact icon button — legacy `.btn-icon` (32×32) with white hover tint (legacy
// `rgba(255,255,255,0.12)`) and a native tooltip, so secondary actions stay out
// of the way of the primary text buttons and the navbar stays tidy.
component IconBtn inherits Rectangle {
    in property <string> icon: "";
    in property <string> tip: "";
    callback clicked();

    width: 32px;
    height: 32px;
    border-radius: 6px;
    background: ta.has-hover ? #ffffff1f : #ffffff08;

    transform-scale-x: ta.has-hover ? 1.07 : 1.0;
    transform-scale-y: ta.has-hover ? 1.07 : 1.0;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    drop-shadow-blur: ta.has-hover ? 6px : 0px;
    drop-shadow-color: #ffd70055;
    animate transform-scale-x { duration: 120ms; easing: ease-out; }
    animate transform-scale-y { duration: 120ms; easing: ease-out; }
    animate drop-shadow-blur { duration: 120ms; easing: ease-out; }

    Text {
        text: root.icon;
        color: ta.has-hover ? #ffffff : #cbd5e1;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Tooltip {
        Text { text: root.tip; font-size: 11px; color: #f8fafc; }
    }
}

component NavPrimaryBtn inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    callback clicked();

    height: 32px;
    border-radius: 6px;
    background: root.active ? @linear-gradient(135deg, #00f0ff, #0099ff)
                            : @linear-gradient(135deg, #ffd700, #d4af37);
    drop-shadow-blur: ta.has-hover ? 10px : 2px;
    drop-shadow-color: root.active ? #00f0ff66 : #ffd70066;

    transform-scale-x: ta.has-hover ? 1.04 : 1.0;
    transform-scale-y: ta.has-hover ? 1.04 : 1.0;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    animate transform-scale-x { duration: 120ms; easing: ease-out; }
    animate transform-scale-y { duration: 120ms; easing: ease-out; }
    animate drop-shadow-blur { duration: 120ms; easing: ease-out; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: root.text;
            color: #000000;
            font-size: 12px;
            font-weight: 700;
        }
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Navbar inherits Rectangle {
    height: 60px;
    background: #000000;

    callback open-file-clicked();
    callback open-custom-image-clicked();
    callback open-hardware-clicked();
    callback open-about-clicked();
    callback open-export-clicked();
    callback theme-preset-selected(string);
    callback save-preset-clicked();
    callback load-preset-clicked();
    callback ticker-clicked();
    callback listen-clicked();
    callback stop-listen-clicked();
    callback mic-device-selected(string);
    callback toggle-preview-clicked();
    callback minimize-clicked();
    callback maximize-clicked();
    callback close-clicked();
    callback drag-pressed(float, float);
    callback drag-moved(float, float);
    callback drag-released();

    in-out property <bool> is-listening: false;
    in-out property <string> listen-status: "";

    // Mic capture device picker (populated from `arecord -l` by the backend).
    in-out property <[string]> mic-devices: [];
    in-out property <string> mic-device-label: "Default (System)";
    in-out property <bool> show-mic-picker: false;

    in-out property <string> ticker-text: "✦ Powered by CredibleMark — Professional Web, Mobile & Desktop Software Development • Visit crediblemark.com • ";
    private property <float> ticker-offset: 0.0;
    private property <bool> mic-pulse: false;

    Timer {
        interval: 30ms;
        running: true;
        triggered => {
            root.ticker-offset = root.ticker-offset - 1.0;
            if (root.ticker-offset <= -600.0) {
                root.ticker-offset = 0.0;
            }
        }
    }

    // FULL-NAVBAR DRAG REGION — legacy `data-tauri-drag-region` on the whole
    // header. Sits behind all interactive elements so it only receives events
    // on empty/padding areas of the bar. The frameless window is dragged from
    // here; buttons on top consume their own clicks.
    drag-ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: default;
        pointer-event(p) => {
            // Only the left button drags the window (legacy drag region is left-drag).
            if (p.kind == PointerEventKind.down && p.button == PointerEventButton.left) { root.drag-pressed(drag-ta.mouse-x / 1px, drag-ta.mouse-y / 1px); }
            else if (p.kind == PointerEventKind.move) { root.drag-moved(drag-ta.mouse-x / 1px, drag-ta.mouse-y / 1px); }
            else if (p.kind == PointerEventKind.up) { root.drag-released(); }
        }
    }

    // Legacy `.navbar { padding: 0 20px; justify-content: space-between }` with
    // two clusters: `.navbar-left` (brand + ticker + primary actions) and
    // `.navbar-right` (icon actions + export + window controls), each gap 16px.
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 0;
        alignment: space-between;
        cross-axis-alignment: center;

        // ============ LEFT TOOLBAR CLUSTER ============
        left-cluster := HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 10px;
            cross-axis-alignment: center;

            // BRAND — logo + AudioWave + Studio badge
            HorizontalLayout {
                spacing: 8px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 8px;
                    background: @linear-gradient(135deg, #ffd70040 0%, #d4af3726 100%);
                    clip: true;
                    Image {
                        source: @image-url("assets/icon.png");
                        width: 28px;
                        height: 28px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "AudioWave";
                    color: #ffffff;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 50px;
                    height: 20px;
                    border-radius: 5px;
                    background: @linear-gradient(135deg, #ffd700, #d4af37);
                    Text {
                        text: "Studio";
                        color: #000000;
                        font-size: 10px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                width: 1px;
                height: 20px;
                background: #ffffff1f;
            }

            NavPrimaryBtn {
                text: "📂 Open Track";
                clicked => { root.open-file-clicked(); }
            }

            listen-btn := NavPrimaryBtn {
                active: root.is-listening;
                text: root.is-listening ? "⏹ Stop Listen" : "🎧 Listen";
                clicked => {
                    if (root.is-listening) { root.stop-listen-clicked(); }
                    else { root.listen-clicked(); }
                }
            }

            // LIVE mic status pill — only rendered while the mic is on, so the
            // waveform source is always visible in the navbar.
            Rectangle {
                visible: root.is-listening;
                height: 28px;
                border-radius: 14px;
                background: #16a34a18;
                border-width: 1px;
                border-color: #16a34a55;
                HorizontalLayout {
                    spacing: 6px;
                    padding-left: 10px;
                    padding-right: 12px;
                    alignment: center;

                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.mic-pulse ? #22c55e : #16a34a;
                    }
                    Text {
                        text: "Mic Live";
                        color: #86efac;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // FLEXIBLE CENTER TICKER (Auto-width borderless marquee)
        Rectangle {
            horizontal-stretch: 1;
            min-width: 120px;
            height: 28px;
            background: ticker-ta.has-hover ? #ffffff0d : transparent;
            clip: true;

            HorizontalLayout {
                x: root.ticker-offset * 1px;
                y: 0;
                spacing: 40px;
                height: parent.height;

                Text {
                    text: root.ticker-text;
                    color: #ffd700;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Text {
                    text: root.ticker-text;
                    color: #ffd700;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            // Left Edge Fade Overlay
            Rectangle {
                x: 0;
                y: 0;
                width: 24px;
                height: parent.height;
                background: @linear-gradient(90deg, #000000 0%, #00000000 100%);
            }

            // Right Edge Fade Overlay
            Rectangle {
                x: parent.width - 24px;
                y: 0;
                width: 24px;
                height: parent.height;
                background: @linear-gradient(270deg, #000000 0%, #00000000 100%);
            }

            ticker-ta := TouchArea {
                width: parent.width;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.ticker-clicked(); }
            }
        }

        // SPACER — absorbs extra width cleanly between toolbar and right tools
        Rectangle {
            horizontal-stretch: 1;
        }

        Timer {
            interval: 500ms;
            running: true;
            triggered() => {
                if (root.is-listening) { root.mic-pulse = !root.mic-pulse; }
                else { root.mic-pulse = false; }
            }
        }

        // ============ RIGHT CLUSTER ============
        HorizontalLayout {
            horizontal-stretch: 0;
            spacing: 6px;
            cross-axis-alignment: center;

            IconBtn {
                icon: "💾";
                tip: "Save Preset";
                clicked => { root.save-preset-clicked(); }
            }

            IconBtn {
                icon: "📂";
                tip: "Load Preset";
                clicked => { root.load-preset-clicked(); }
            }

            IconBtn {
                icon: "⚡";
                tip: "Hardware Info";
                clicked => { root.open-hardware-clicked(); }
            }

            IconBtn {
                icon: "ℹ";
                tip: "About";
                clicked => { root.open-about-clicked(); }
            }

            IconBtn {
                icon: "↗";
                tip: "Pop-out Preview Window";
                clicked => { root.toggle-preview-clicked(); }
            }

            NavPrimaryBtn {
                text: "🎬 Export Video";
                clicked => { root.open-export-clicked(); }
            }

            // WINDOW CONTROLS — legacy .window-controls: border-left divider,
            // 2px gap, 32×28 buttons (frameless window replacement).
            Rectangle {
                width: 1px;
                height: 24px;
                background: #ffffff1f;
            }

            HorizontalLayout {
                spacing: 2px;

                min-btn := Rectangle {
                    width: 32px;
                    height: 28px;
                    border-radius: 4px;
                    background: min-ta.has-hover ? #ffffff1a : transparent;

                    transform-scale-x: min-ta.has-hover ? 1.06 : 1.0;
                    transform-scale-y: min-ta.has-hover ? 1.06 : 1.0;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    drop-shadow-blur: min-ta.has-hover ? 5px : 0px;
                    drop-shadow-color: #ffffff33;
                    animate transform-scale-x { duration: 100ms; easing: ease-out; }
                    animate transform-scale-y { duration: 100ms; easing: ease-out; }
                    animate drop-shadow-blur { duration: 100ms; easing: ease-out; }

                    // Vector horizontal bar for Minimize
                    Rectangle {
                        width: 10px;
                        height: 2px;
                        border-radius: 1px;
                        background: min-ta.has-hover ? #ffffff : #94a3b8;
                    }

                    min-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        clicked => { root.minimize-clicked(); }
                    }
                }

                max-btn := Rectangle {
                    width: 32px;
                    height: 28px;
                    border-radius: 4px;
                    background: max-ta.has-hover ? #ffffff1a : transparent;

                    transform-scale-x: max-ta.has-hover ? 1.06 : 1.0;
                    transform-scale-y: max-ta.has-hover ? 1.06 : 1.0;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    drop-shadow-blur: max-ta.has-hover ? 5px : 0px;
                    drop-shadow-color: #ffffff33;
                    animate transform-scale-x { duration: 100ms; easing: ease-out; }
                    animate transform-scale-y { duration: 100ms; easing: ease-out; }
                    animate drop-shadow-blur { duration: 100ms; easing: ease-out; }

                    // Vector square outline for Maximize
                    Rectangle {
                        width: 10px;
                        height: 10px;
                        border-width: 1.5px;
                        border-color: max-ta.has-hover ? #ffffff : #94a3b8;
                        border-radius: 1px;
                        background: transparent;
                    }

                    max-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        clicked => { root.maximize-clicked(); }
                    }
                }

                close-btn := Rectangle {
                    width: 32px;
                    height: 28px;
                    border-radius: 4px;
                    background: close-ta.has-hover ? #e81123 : transparent;

                    transform-scale-x: close-ta.has-hover ? 1.08 : 1.0;
                    transform-scale-y: close-ta.has-hover ? 1.08 : 1.0;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    drop-shadow-blur: close-ta.has-hover ? 8px : 0px;
                    drop-shadow-color: #e8112366;
                    animate transform-scale-x { duration: 100ms; easing: ease-out; }
                    animate transform-scale-y { duration: 100ms; easing: ease-out; }
                    animate drop-shadow-blur { duration: 100ms; easing: ease-out; }

                    // Vector X cross for Close
                    Path {
                        width: 10px;
                        height: 10px;
                        stroke: close-ta.has-hover ? #ffffff : #94a3b8;
                        stroke-width: 1.5px;
                        MoveTo { x: 0; y: 0; }
                        LineTo { x: 10; y: 10; }
                        MoveTo { x: 10; y: 0; }
                        LineTo { x: 0; y: 10; }
                    }

                    close-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        clicked => { root.close-clicked(); }
                    }
                }
            }
        }
    }


    // Legacy gold border-bottom (rgba(255, 215, 0, 0.2))
    Rectangle {
        y: root.height - 1px;
        width: parent.width;
        height: 1px;
        background: #ffd70033;
    }
}

import { ModalBtn } from "export_modal.slint";

export component AboutModal inherits Rectangle {
    width: 100%;
    height: 100%;
    background: #000000b0;

    callback close-clicked();

    Rectangle {
        width: 420px;
        height: 240px;
        background: #0a0a0a;
        border-radius: 12px;

        VerticalLayout {
            padding: 20px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                cross-axis-alignment: center;

                Image {
                    source: @image-url("assets/icon.png");
                    width: 28px;
                    height: 28px;
                }

                Text {
                    text: "AudioWave Studio v1.14.3";
                    font-size: 17px;
                    font-weight: 700;
                    color: #ffd700;
                    vertical-alignment: center;
                }

                Rectangle { horizontal-stretch: 1; }

                // Legacy modal ✕ close button (top-right corner) with the same
                // lift + glow micro-interaction as the navbar IconBtn.
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: 6px;
                    background: close-ta.has-hover ? #ffffff1f : transparent;

                    transform-scale-x: close-ta.has-hover ? 1.07 : 1.0;
                    transform-scale-y: close-ta.has-hover ? 1.07 : 1.0;
                    transform-origin: { x: self.width / 2, y: self.height / 2 };
                    drop-shadow-blur: close-ta.has-hover ? 6px : 0px;
                    drop-shadow-color: #ffffff33;
                    animate transform-scale-x { duration: 120ms; easing: ease-out; }
                    animate transform-scale-y { duration: 120ms; easing: ease-out; }
                    animate drop-shadow-blur { duration: 120ms; easing: ease-out; }

                    Path {
                        width: 10px;
                        height: 10px;
                        stroke: close-ta.has-hover ? #ffffff : #94a3b8;
                        stroke-width: 1.5px;
                        MoveTo { x: 0; y: 0; }
                        LineTo { x: 10; y: 10; }
                        MoveTo { x: 10; y: 0; }
                        LineTo { x: 0; y: 10; }
                    }

                    close-ta := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        clicked => { root.close-clicked(); }
                    }

                    Tooltip {
                        Text { text: "Close"; font-size: 11px; color: #f8fafc; }
                    }
                }
            }

            Text { text: "Pure Rust & Slint UI High-Performance Audio Visualizer"; color: #f8fafc; font-size: 13px; }
            Text { text: "Features 134 Visualizer Styles, Hardware GPU Acceleration, custom background images, floating particles, and 60 FPS video export."; color: #a3a3a3; font-size: 12px; wrap: word-wrap; }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                Rectangle { horizontal-stretch: 1; }
                ModalBtn {
                    text: "Close";
                    clicked => { root.close-clicked(); }
                }
            }
        }
    }
}

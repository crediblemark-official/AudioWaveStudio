{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioWave Studio",
  "version": "1.8.0",
  "identifier": "com.audiowave.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AudioWave Studio - Desktop Audio Visualizer",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 650,
        "decorations": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["ffmpeg"]
      }
    }
  }
}
